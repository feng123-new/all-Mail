# Canonical production environment template.
#
# Default deployment:
#   cp .env.example .env
#   docker compose up -d --build --wait --wait-timeout 240
#
# PostgreSQL and Redis stay private to the Compose network. Local API development
# uses docker-compose.dev.yml to publish fixed development ports.

COMPOSE_PROJECT_NAME=all-mail
APP_PUBLISH_HOST=127.0.0.1
APP_PORT=3002

POSTGRES_USER=allmail
# Required. Use a URL-safe value, for example: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=allmail

# Comma-separated CIDRs for the reverse proxy directly connected to the Go app.
# Leave empty for direct access. The gateway discards all forwarded-IP headers
# from peers outside this list.
TRUSTED_PROXY_CIDRS=
READY_TIMEOUT_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=15
WORKER_HEARTBEAT_SECONDS=15
WORKER_HEARTBEAT_MAX_AGE_SECONDS=90

# Long-lived runtime secrets. Missing values are generated by legacy-init and
# persisted in /var/lib/all-mail/runtime-secrets.env.
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=2h

# One-shot administrator bootstrap. These values are consumed only by
# legacy-init; they are not injected into the long-running Fastify API. Remove
# a non-empty ADMIN_PASSWORD from this file after the first successful startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PUBLIC_BASE_URL=
ALL_MAIL_PRINT_BOOTSTRAP_PASSWORD=false
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_2FA_WINDOW=1

# Go retention worker.
API_LOG_RETENTION_DAYS=30
API_LOG_CLEANUP_INTERVAL_MINUTES=60
API_LOG_CLEANUP_RETRY_SECONDS=30
API_LOG_CLEANUP_TIMEOUT_SECONDS=60
API_LOG_CLEANUP_BATCH_SIZE=5000
API_LOG_CLEANUP_MAX_BATCHES=10

# Go forwarding worker.
FORWARDING_WORKER_INTERVAL_SECONDS=30
FORWARDING_WORKER_BATCH_SIZE=10
FORWARDING_RUN_TIMEOUT_SECONDS=120
# Must exceed run timeout + shutdown timeout + safety margin.
FORWARDING_LEASE_SECONDS=180

# One-shot compatibility import. legacy-init copies these values into encrypted
# or audited PostgreSQL state. The long-running API never receives them. Remove
# populated values after one successful deployment and verification.
SEND_ENABLED_DOMAINS=
INGRESS_SIGNING_SECRET=
INGRESS_IMPORT_KEY_ID=allmail-edge-main

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3002/admin/oauth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.modify https://mail.google.com/
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://127.0.0.1:3002/admin/oauth/outlook/callback
MICROSOFT_OAUTH_TENANT=consumers
MICROSOFT_OAUTH_SCOPES=offline_access openid profile email https://graph.microsoft.com/User.Read https://graph.microsoft.com/Mail.ReadWrite https://graph.microsoft.com/Mail.Send https://graph.microsoft.com/Contacts.ReadWrite https://graph.microsoft.com/Calendars.ReadWrite https://graph.microsoft.com/MailboxSettings.ReadWrite

# Runtime ingress policy. The signing secret itself is database-managed.
INGRESS_ALLOWED_SKEW_SECONDS=300
