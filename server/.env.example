# Advanced Node source-runtime template.
#
# Canonical production deployments use the root `.env.example` or
# `.env.cloudflare.example` with Docker Compose. This file starts Fastify and
# the compatibility Node jobs process directly; it does not validate the Go
# gateway or Go workers.

# Server
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=
ALL_MAIL_STATE_DIR=.all-mail-runtime
ALL_MAIL_PRINT_BOOTSTRAP_PASSWORD=false

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Emergency compatibility repair for a reviewed Prisma P3005 case only.
# Keep false during normal startup.
ALL_MAIL_ALLOW_LEGACY_DB_PUSH_REPAIR=false

# Redis (optional, strongly recommended)
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=
ALLOW_LOCAL_RATE_LIMIT_FALLBACK=false

# Security / bootstrap secrets
# Leave blank to generate and persist them in ALL_MAIL_STATE_DIR.
JWT_SECRET=
JWT_EXPIRES_IN=2h
ENCRYPTION_KEY=

# Bootstrap admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DOMAIN_BOOTSTRAP_ADMIN_USERNAME=admin
DOMAIN_BOOTSTRAP_ADMIN_PASSWORD=
SEND_ENABLED_DOMAINS=

# Login protection
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_2FA_SECRET=
ADMIN_2FA_WINDOW=1

# Compatibility Node jobs
API_LOG_RETENTION_OWNER=legacy
API_LOG_RETENTION_DAYS=30
API_LOG_CLEANUP_INTERVAL_MINUTES=60
FORWARDING_WORKER_OWNER=legacy
FORWARDING_WORKER_INTERVAL_SECONDS=30
FORWARDING_WORKER_BATCH_SIZE=10

# Ingress/runtime extras
INGRESS_SIGNING_SECRET=
INGRESS_ALLOWED_SKEW_SECONDS=300

# Optional provider OAuth fallbacks
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/admin/oauth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.modify https://mail.google.com/
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/admin/oauth/outlook/callback
MICROSOFT_OAUTH_TENANT=consumers
MICROSOFT_OAUTH_SCOPES=offline_access openid profile email https://graph.microsoft.com/User.Read https://graph.microsoft.com/Mail.ReadWrite https://graph.microsoft.com/Mail.Send https://graph.microsoft.com/Contacts.ReadWrite https://graph.microsoft.com/Calendars.ReadWrite https://graph.microsoft.com/MailboxSettings.ReadWrite
