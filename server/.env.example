# Fastify business-API development template.
#
# Start PostgreSQL and Redis with:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres redis
#
# Canonical production deployments use the root `.env.example` with Docker
# Compose. This file starts only the compatibility Fastify API for local
# development; it does not serve React, run Go workers, or create administrators.

# Server
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:5173

# Local infrastructure published by docker-compose.dev.yml
# Replace the password with the same POSTGRES_PASSWORD used by the root .env
# that started PostgreSQL through docker-compose.dev.yml.
DATABASE_URL=postgresql://allmail:replace-with-root-postgres-password@127.0.0.1:15433/allmail
REDIS_URL=redis://127.0.0.1:6380
CORS_ORIGIN=http://127.0.0.1:5173

# Long-lived application secrets
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=2h
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# The API can remove this one-time file after the initial password is changed,
# but it never reads the password from it for login or account creation.
BOOTSTRAP_ADMIN_SECRET_FILE=.all-mail-runtime/bootstrap-admin.env

# Login protection and database-managed 2FA
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_2FA_WINDOW=1

# Ingress replay/clock policy. Endpoint signing secrets, OAuth clients, and
# outbound-send approvals are managed in PostgreSQL rather than this file.
INGRESS_ALLOWED_SKEW_SECONDS=300

# Before starting the API against a fresh development database:
#   npm --prefix server run db:migrate
#   ADMIN_USERNAME=admin ADMIN_PASSWORD=change-me-now \
#     BOOTSTRAP_ADMIN_SECRET_FILE=.all-mail-runtime/bootstrap-admin.env \
#     npm --prefix server run bootstrap:admin
# Configure OAuth and domain/ingress state through the administrator APIs, or
# run the one-shot production initializer with legacy import values once.
