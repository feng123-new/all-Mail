# Fastify business-API development template.
#
# Start PostgreSQL and Redis with:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres redis
#
# Canonical production deployments use the root `.env.example` with Docker
# Compose. This file starts only the compatibility Fastify API for local
# development; it does not serve the React application or run Go workers.

# Server
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:5173

# Local development infrastructure published by docker-compose.dev.yml
DATABASE_URL=postgresql://allmail:allmail_dev_password@127.0.0.1:15433/allmail
REDIS_URL=redis://127.0.0.1:6380
CORS_ORIGIN=http://127.0.0.1:5173
ALLOW_LOCAL_RATE_LIMIT_FALLBACK=false

# Security / bootstrap secrets
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=2h
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Bootstrap admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-development-password
DOMAIN_BOOTSTRAP_ADMIN_USERNAME=admin
DOMAIN_BOOTSTRAP_ADMIN_PASSWORD=
SEND_ENABLED_DOMAINS=

# Login protection
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_2FA_SECRET=
ADMIN_2FA_WINDOW=1

# Ingress/runtime extras
INGRESS_SIGNING_SECRET=
INGRESS_ALLOWED_SKEW_SECONDS=300

# Optional provider OAuth fallbacks
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/admin/oauth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.modify https://mail.google.com/
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/admin/oauth/outlook/callback
MICROSOFT_OAUTH_TENANT=consumers
MICROSOFT_OAUTH_SCOPES=offline_access openid profile email https://graph.microsoft.com/User.Read https://graph.microsoft.com/Mail.ReadWrite https://graph.microsoft.com/Mail.Send https://graph.microsoft.com/Contacts.ReadWrite https://graph.microsoft.com/Calendars.ReadWrite https://graph.microsoft.com/MailboxSettings.ReadWrite
