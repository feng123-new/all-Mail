{
    "name": "all-mail-server",
    "version": "2.0.0",
    "description": "all-Mail compatibility business API - Fastify + TypeScript + Prisma",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "npm run dev:api",
        "dev:api": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "test": "node --test --test-force-exit --import tsx src/**/*.test.ts",
        "start": "npm run start:api",
        "start:api": "node dist/index.js",
        "bootstrap:admin": "tsx src/runtime/bootstrapAdmin.ts",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:repair:legacy-p3005": "prisma db execute --file prisma/legacy-p3005-repair.sql --schema prisma/schema.prisma",
        "db:migrate": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "ingress:ensure": "tsx scripts/ensure-ingress-endpoint.ts",
        "ingress:check": "tsx scripts/ensure-ingress-endpoint.ts --check"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^11.3.0",
        "@fastify/helmet": "^13.1.0",
        "@prisma/client": "^6.19.3",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "fastify": "^5.10.0",
        "fastify-plugin": "^6.0.0",
        "ioredis": "^5.11.1",
        "jose": "^6.2.5",
        "mailparser": "^3.9.14",
        "node-imap": "^0.9.6",
        "nodemailer": "^9.0.3",
        "pino": "^10.3.1",
        "prisma": "^6.19.3",
        "resend": "^6.18.1",
        "undici": "^8.9.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/mailparser": "^3.4.5",
        "@types/node": "^26.1.2",
        "@types/node-imap": "^0.9.3",
        "@types/nodemailer": "^8.0.1",
        "eslint": "^9.39.5",
        "globals": "^17.8.0",
        "pino-pretty": "^13.0.0",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "overrides": {
        "brace-expansion": "5.0.8",
        "defu": "6.1.6",
        "effect": "3.21.0",
        "fast-uri": "4.1.1",
        "yaml": "2.8.3",
        "utf7": {
            "semver": "5.7.2"
        }
    }
}
