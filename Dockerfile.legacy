FROM node:26-bookworm-slim AS base
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl ca-certificates gosu util-linux \
    && rm -rf /var/lib/apt/lists/*

FROM base AS server-deps
WORKDIR /app/server
COPY server/package*.json ./
RUN npm ci --include=dev

FROM base AS builder
WORKDIR /app
COPY --from=server-deps /app/server/node_modules ./server/node_modules
COPY server ./server
RUN cd server \
    && npm run db:generate \
    && npm run build \
    && npm prune --omit=dev

FROM base AS runtime
WORKDIR /app/server
ENV NODE_ENV=production \
    ALL_MAIL_STATE_DIR=/var/lib/all-mail

RUN groupadd --system --gid 10001 allmail \
    && useradd --system --uid 10001 --gid allmail --home-dir /var/lib/all-mail --shell /usr/sbin/nologin allmail \
    && mkdir -p /app/server /app/scripts /var/lib/all-mail \
    && chown -R allmail:allmail /app /var/lib/all-mail

COPY --chown=allmail:allmail --from=builder /app/server/dist ./dist
COPY --chown=allmail:allmail --from=builder /app/server/node_modules ./node_modules
COPY --chown=allmail:allmail --from=builder /app/server/package*.json ./
COPY --chown=allmail:allmail --from=builder /app/server/prisma ./prisma
COPY --chown=allmail:allmail scripts/bootstrap-secrets.mjs ../scripts/
COPY --chown=allmail:allmail scripts/runtime-access.mjs ../scripts/
COPY --chown=allmail:allmail scripts/validate-production-config.mjs ../scripts/
COPY --chown=allmail:allmail scripts/sanitize-runtime-env.sh ../scripts/
COPY docker/entrypoint.sh /usr/local/bin/all-mail-entrypoint

RUN sed -i 's/\r$//' /usr/local/bin/all-mail-entrypoint \
    && sed -i 's/\r$//' /app/scripts/sanitize-runtime-env.sh \
    && chmod 0755 /usr/local/bin/all-mail-entrypoint /app/scripts/sanitize-runtime-env.sh

EXPOSE 3100
ENTRYPOINT ["all-mail-entrypoint"]
CMD ["api"]
