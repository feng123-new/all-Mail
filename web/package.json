{
  "name": "all-mail-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:openapi": "node ../scripts/generate-openapi.mjs --output public/openapi.json",
    "dev": "npm run generate:openapi && node --disable-warning=UNDICI-EHPA ./scripts/run-clean-node.mjs \"vite\"",
    "build": "npm run generate:openapi && node --disable-warning=UNDICI-EHPA ./scripts/run-clean-node.mjs \"tsc -b && vite build\"",
    "check:budget": "node ./scripts/check-build-budget.mjs",
    "lint": "node --disable-warning=UNDICI-EHPA ./scripts/run-clean-node.mjs \"eslint .\"",
    "preview": "node --disable-warning=UNDICI-EHPA ./scripts/run-clean-node.mjs \"vite preview\"",
    "test": "node --disable-warning=UNDICI-EHPA ./scripts/run-clean-node.mjs \"vitest run\"",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.2",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router": "8.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "27.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "4.1.2",
    "lodash": "4.18.1",
    "postcss": "8.5.24",
    "styled-components": "6.4.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
